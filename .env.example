# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
YOUTUBE_API_KEY=
HN_POLL_SECONDS=60
KAFKA_BOOTSTRAP=localhost:9092
WIKI_USER_AGENT=trend-radar/0.1 (resume project; contact: set-your-contact-here)
STATE_DIR=.state
# Prometheus /metrics ports (one per process)
METRICS_ADDR=0.0.0.0
METRICS_PORT_BLUESKY=8001
METRICS_PORT_WIKIPEDIA=8002
METRICS_PORT_HACKERNEWS=8003
METRICS_PORT_DB_SINK=8004
# Grafana admin login (local only)
GRAFANA_ADMIN_PASSWORD=admin

# API / Text-to-SQL (read-only role created by scripts/create_readonly_role.py)
DATABASE_URL_READONLY=postgresql://api_readonly:PASSWORD@HOST/DBNAME?sslmode=require
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
